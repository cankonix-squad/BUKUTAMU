# Salin menjadi .env lalu isi. JANGAN commit file .env ke git.

# Rahasia JWT (min. 32 karakter):   openssl rand -hex 32
JWT_SECRET=
# Kunci enkripsi NIK & kunci hash (masing-masing 64 karakter hex): openssl rand -hex 32
# PENTING: simpan cadangan kunci ini. Bila hilang, NIK yang tersimpan tidak bisa dibaca lagi.
NIK_ENC_KEY=
NIK_HASH_KEY=

# Akun admin awal (dibuat otomatis saat tabel pengguna kosong)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Masa simpan data kunjungan dalam hari (0 = tidak dihapus otomatis)
RETENTION_DAYS=365

# Integrasi Dukcapil: mock (data fiktif) | http (layanan resmi, setelah PKS)
DUKCAPIL_MODE=mock
DUKCAPIL_URL=
DUKCAPIL_USER=
DUKCAPIL_PASSWORD=
DUKCAPIL_IP=

# Hanya untuk menjalankan backend langsung (tanpa docker)
DATABASE_URL=postgres://bukutamu:bukutamu@localhost:5432/bukutamu?sslmode=disable
STORAGE_DIR=./data/foto
CORS_ORIGIN=http://localhost:5173
TZ=Asia/Jakarta
